# =====================
#  外觀與視窗設定 / Appearance & window
# =====================
theme = Catppuccin Frappe
# Nerd Font 必須安裝，p10k 及 tmux 狀態列圖示依賴此字型
font-family = MesloLGS Nerd Font
font-size = 19
# 捲動緩衝區行數上限
scrollback-limit = 10000
background-opacity = 0.8
# 背景模糊半徑 (搭配透明度產生漂亮的毛玻璃效果)
background-blur = 20

# 顯示視窗裝飾 (顯示原生的 Mac 標題列與紅黃綠燈按鈕)
window-decoration = true

# 從 Dock/Launchpad 啟動時，預設工作目錄為 $HOME（避免繼承 launchd 的 /）
working-directory = home

# =====================
#  系統與鍵盤設定 / System & keyboard
# =====================
# 將 Mac 的 Option 鍵視為終端機裡的 Alt (Meta) 鍵
# (這對在 Tmux 或 Vim 裡面使用組合鍵非常重要)
macos-option-as-alt = true

# 桌面通知 (當耗時的指令跑完時，Mac 的 Dock 圖示會跳動提醒你)
desktop-notifications = true

# =====================
#  游標與滑鼠設定 / Cursor & mouse
# =====================
# 打字時自動隱藏滑鼠游標
mouse-hide-while-typing = true

# 網址連結支援 (按住 Cmd 鍵並點擊網址，可以直接用預設瀏覽器開啟)
link-url = true

# =====================
#  剪貼簿與快捷鍵 / Clipboard & keybindings
# =====================
# 啟用貼上保護 (當貼上的內容包含換行符號時，會先詢問確認，防止多行指令意外直接執行)
clipboard-paste-protection = true

# 綁定 Mac 原生的複製與貼上快捷鍵
keybind = cmd+c=copy_to_clipboard
keybind = cmd+v=paste_from_clipboard

# Omarchy 的 Super+C / Super+V 不會直接送進程式：Hyprland 攔下來後，對終端機視窗
# 改送 Ctrl+Insert / Shift+Insert（見 omarchy 的 default/hypr/bindings/clipboard.lua）。
# Ghostty 在 Linux 預設 Shift+Insert 是貼上滑鼠反白的 primary selection，不是剪貼簿，
# 所以要明確綁到系統剪貼簿，Super+V 才貼得出從 nvim/瀏覽器複製的內容。
# 這兩行是照抄 Omarchy 內建的 ghostty 設定，因為這份 config 會把它蓋掉。
# Omarchy's Super+C / Super+V never reach the app directly: Hyprland intercepts
# them and, for terminal windows, sends Ctrl+Insert / Shift+Insert instead (see
# omarchy's default/hypr/bindings/clipboard.lua). Ghostty's Linux default binds
# Shift+Insert to the primary selection rather than the clipboard, so bind both
# explicitly or Super+V cannot paste what nvim or a browser copied. These mirror
# Omarchy's stock ghostty config, which this file replaces.
keybind = control+insert=copy_to_clipboard
keybind = shift+insert=paste_from_clipboard

# 設定檔管理
keybind = cmd+comma=open_config
keybind = cmd+shift+comma=reload_config

# 切換背景透明度 (看程式碼時切不透明、放鬆時切回透明)
keybind = cmd+shift+o=toggle_background_opacity
